        private sealed record StyleSpec(string DisplayName, int DefaultTempo, int MinMidi, int MaxMidi, int MinDegree, int MaxDegree, int FinalDegree, bool BrokenBass, int[][][] Progressions, int[][] CorePatterns, int[][] LiftPatterns)
        {
