        private sealed record MoodSpec(string DisplayName, int TempoOffset, int MinTempo, int MaxTempo, int RangeOffset, int StartDegree, bool ResolveToThird, int MaxLeap, int[] OpeningChoices, int[] LiftChoices, int[] CadenceChoices, int[] CoreMotion, int[] LiftMotion, int[] CadenceMotion, int[][] CadencePatterns, bool SustainBass)
        {
