<Page
    x:Class="MusicBox.ComposeWorkbenchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{x:Null}">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      VerticalScrollMode="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Disabled">
            <Grid Padding="32,24,32,24">
                <StackPanel Spacing="18">
                    <TextBlock x:Name="PageTitleText"
                               FontSize="24"
                               FontWeight="SemiBold" />

                    <TextBlock x:Name="PageSubtitleText"
                               MaxWidth="880"
                               Visibility="Collapsed"
                               TextWrapping="Wrap"
                               Opacity="0.72" />

                    <Grid ColumnSpacing="14"
                          RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="TitleLabelText"
                                   Grid.Column="0" />
                        <TextBlock x:Name="MoodLabelText"
                                   Grid.Column="1" />
                        <TextBlock x:Name="LengthLabelText"
                                   Grid.Column="2" />

                        <TextBox x:Name="TitleBox"
                                 Grid.Row="1"
                                 Grid.Column="0"
                                 Height="40" />

                        <ComboBox x:Name="MoodBox"
                                  Grid.Row="1"
                                  Grid.Column="1"
                                  Height="40"
                                  MinWidth="210">
                            <ComboBoxItem x:Name="MoodCalmItem" Tag="calm" />
                            <ComboBoxItem x:Name="MoodPositiveItem" Tag="positive" />
                            <ComboBoxItem x:Name="MoodSadItem" Tag="sad" />
                            <ComboBoxItem x:Name="MoodSleepItem" Tag="sleep" />
                            <ComboBoxItem x:Name="MoodHopefulItem" Tag="hopeful" />
                            <ComboBoxItem x:Name="MoodNostalgicItem" Tag="nostalgic" />
                            <ComboBoxItem x:Name="MoodDreamyItem" Tag="dreamy" />
                            <ComboBoxItem x:Name="MoodTenseItem" Tag="tense" />
                        </ComboBox>

                        <ComboBox x:Name="LengthBox"
                                  Grid.Row="1"
                                  Grid.Column="2"
                                  Height="40"
                                  MinWidth="150">
                            <ComboBoxItem x:Name="LengthShortItem" Tag="short" />
                            <ComboBoxItem x:Name="LengthMediumItem" Tag="medium" />
                            <ComboBoxItem x:Name="LengthLongItem" Tag="long" />
                        </ComboBox>

                        <StackPanel Grid.Row="1"
                                    Grid.Column="3"
                                    Orientation="Horizontal"
                                    Spacing="8">
                            <Button x:Name="GenerateButton"
                                    Height="40"
                                    MinWidth="96"
                                    Padding="18,10"
                                    Click="GenerateButton_Click" />
                            <Button x:Name="RetryButton"
                                    Height="40"
                                    MinWidth="96"
                                    Padding="18,10"
                                    Click="RetryButton_Click" />
                        </StackPanel>

                        <TextBlock x:Name="StatusText"
                                   Grid.Row="2"
                                   Grid.ColumnSpan="4"
                                   Visibility="Collapsed"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                    </Grid>

                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  HorizontalScrollMode="Enabled"
                                  VerticalScrollBarVisibility="Disabled"
                                  VerticalScrollMode="Disabled">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="12">
                            <Border Width="344"
                                    Padding="16,16,16,14"
                                    CornerRadius="8"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <Grid RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid>
                                        <TextBlock x:Name="Option1TitleText"
                                                   FontSize="20"
                                                   FontWeight="SemiBold" />
                                        <Button x:Name="Option1KeepButton"
                                                Width="28"
                                                Height="28"
                                                Padding="0"
                                                Margin="0,-2,-2,0"
                                                Tag="0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Click="ToggleKeepButton_Click" />
                                    </Grid>

                                    <TextBlock x:Name="Option1SummaryText"
                                               Grid.Row="1"
                                               MinHeight="132"
                                               TextWrapping="Wrap" />

                                    <Grid Grid.Row="2"
                                          ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="Option1PlayButton"
                                                Grid.Column="0"
                                                Tag="0"
                                                Height="38"
                                                MinWidth="96"
                                                Padding="14,8"
                                                Click="PlayCandidateButton_Click" />
                                        <Button x:Name="Option1ApplyButton"
                                                Grid.Column="1"
                                                Tag="0"
                                                Height="38"
                                                MinWidth="116"
                                                IsEnabled="False"
                                                Click="ApplyCandidateButton_Click" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Width="344"
                                    Padding="16,16,16,14"
                                    CornerRadius="8"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <Grid RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid>
                                        <TextBlock x:Name="Option2TitleText"
                                                   FontSize="20"
                                                   FontWeight="SemiBold" />
                                        <Button x:Name="Option2KeepButton"
                                                Width="28"
                                                Height="28"
                                                Padding="0"
                                                Margin="0,-2,-2,0"
                                                Tag="1"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Click="ToggleKeepButton_Click" />
                                    </Grid>

                                    <TextBlock x:Name="Option2SummaryText"
                                               Grid.Row="1"
                                               MinHeight="132"
                                               TextWrapping="Wrap" />

                                    <Grid Grid.Row="2"
                                          ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="Option2PlayButton"
                                                Grid.Column="0"
                                                Tag="1"
                                                Height="38"
                                                MinWidth="96"
                                                Padding="14,8"
                                                Click="PlayCandidateButton_Click" />
                                        <Button x:Name="Option2ApplyButton"
                                                Grid.Column="1"
                                                Tag="1"
                                                Height="38"
                                                MinWidth="116"
                                                IsEnabled="False"
                                                Click="ApplyCandidateButton_Click" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Width="344"
                                    Padding="16,16,16,14"
                                    CornerRadius="8"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <Grid RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid>
                                        <TextBlock x:Name="Option3TitleText"
                                                   FontSize="20"
                                                   FontWeight="SemiBold" />
                                        <Button x:Name="Option3KeepButton"
                                                Width="28"
                                                Height="28"
                                                Padding="0"
                                                Margin="0,-2,-2,0"
                                                Tag="2"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Click="ToggleKeepButton_Click" />
                                    </Grid>

                                    <TextBlock x:Name="Option3SummaryText"
                                               Grid.Row="1"
                                               MinHeight="132"
                                               TextWrapping="Wrap" />

                                    <Grid Grid.Row="2"
                                          ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="Option3PlayButton"
                                                Grid.Column="0"
                                                Tag="2"
                                                Height="38"
                                                MinWidth="96"
                                                Padding="14,8"
                                                Click="PlayCandidateButton_Click" />
                                        <Button x:Name="Option3ApplyButton"
                                                Grid.Column="1"
                                                Tag="2"
                                                Height="38"
                                                MinWidth="116"
                                                IsEnabled="False"
                                                Click="ApplyCandidateButton_Click" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
