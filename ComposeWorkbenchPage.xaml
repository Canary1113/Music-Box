<Page
    x:Class="MusicBox.ComposeWorkbenchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{x:Null}">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      VerticalScrollMode="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Disabled">
            <Grid Padding="32,24,32,24">
                <StackPanel Spacing="16">
                    <TextBlock Text="智能创作"
                               FontSize="24"
                               FontWeight="SemiBold" />

                    <TextBlock Text="系统会自动决定速度、拍号和调性，一次给出 3 个明显不同的候选方案。"
                               TextWrapping="Wrap"
                               Opacity="0.72" />

                    <Grid ColumnSpacing="14"
                          RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="210" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Column="0"
                                    Spacing="8">
                            <TextBlock Text="标题" />
                            <TextBox x:Name="TitleBox"
                                     Text="智能创作" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Spacing="8">
                            <TextBlock Text="情绪" />
                            <ComboBox x:Name="MoodBox"
                                      MinWidth="200">
                                <ComboBoxItem Content="平静"
                                              Tag="calm" />
                                <ComboBoxItem Content="积极"
                                              Tag="positive" />
                                <ComboBoxItem Content="伤感"
                                              Tag="sad" />
                                <ComboBoxItem Content="助眠"
                                              Tag="sleep" />
                                <ComboBoxItem Content="希望"
                                              Tag="hopeful" />
                                <ComboBoxItem Content="怀旧"
                                              Tag="nostalgic" />
                                <ComboBoxItem Content="梦幻"
                                              Tag="dreamy" />
                                <ComboBoxItem Content="紧张"
                                              Tag="tense" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Spacing="8">
                            <TextBlock Text="长度" />
                            <ComboBox x:Name="LengthBox"
                                      MinWidth="140">
                                <ComboBoxItem Content="短"
                                              Tag="short" />
                                <ComboBoxItem Content="中"
                                              Tag="medium" />
                                <ComboBoxItem Content="长"
                                              Tag="long" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="3"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    Margin="0,26,0,0">
                            <Button x:Name="GenerateButton"
                                    Height="40"
                                    MinWidth="74"
                                    Padding="18,10"
                                    Click="GenerateButton_Click"
                                    Content="生成" />
                            <Button x:Name="RetryButton"
                                    Height="36"
                                    MinWidth="88"
                                    Padding="12,8"
                                    Click="RetryButton_Click" />
                        </StackPanel>

                        <TextBlock x:Name="StatusText"
                                   Grid.Row="1"
                                   Grid.ColumnSpan="4"
                                   Visibility="Collapsed"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                    </Grid>

                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  HorizontalScrollMode="Enabled"
                                  VerticalScrollBarVisibility="Disabled"
                                  VerticalScrollMode="Disabled">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="12">
                            <Border Width="336"
                                    Padding="16,16,16,14"
                                    CornerRadius="8"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <Grid RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <TextBlock Text="方案 A"
                                                   FontSize="20"
                                                   FontWeight="SemiBold" />
                                        <Button x:Name="Option1KeepButton"
                                                Width="30"
                                                Height="30"
                                                Padding="0"
                                                Margin="0,-4,-4,0"
                                                Tag="0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Click="ToggleKeepButton_Click" />
                                    </Grid>
                                    <TextBlock x:Name="Option1SummaryText"
                                               Grid.Row="1"
                                               MinHeight="126"
                                               Text="等待生成"
                                               TextWrapping="Wrap" />
                                    <Grid Grid.Row="2"
                                          ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="Option1PlayButton"
                                                Grid.Column="0"
                                                Tag="0"
                                                Height="36"
                                                MinWidth="92"
                                                Padding="14,8"
                                                Click="PlayCandidateButton_Click" />
                                        <Button x:Name="Option1ApplyButton"
                                                Grid.Column="1"
                                                Tag="0"
                                                Height="36"
                                                Content="写入编辑页"
                                                IsEnabled="False"
                                                Click="ApplyCandidateButton_Click" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Width="336"
                                    Padding="16,16,16,14"
                                    CornerRadius="8"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <Grid RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <TextBlock Text="方案 B"
                                                   FontSize="20"
                                                   FontWeight="SemiBold" />
                                        <Button x:Name="Option2KeepButton"
                                                Width="30"
                                                Height="30"
                                                Padding="0"
                                                Margin="0,-4,-4,0"
                                                Tag="1"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Click="ToggleKeepButton_Click" />
                                    </Grid>
                                    <TextBlock x:Name="Option2SummaryText"
                                               Grid.Row="1"
                                               MinHeight="126"
                                               Text="等待生成"
                                               TextWrapping="Wrap" />
                                    <Grid Grid.Row="2"
                                          ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="Option2PlayButton"
                                                Grid.Column="0"
                                                Tag="1"
                                                Height="36"
                                                MinWidth="92"
                                                Padding="14,8"
                                                Click="PlayCandidateButton_Click" />
                                        <Button x:Name="Option2ApplyButton"
                                                Grid.Column="1"
                                                Tag="1"
                                                Height="36"
                                                Content="写入编辑页"
                                                IsEnabled="False"
                                                Click="ApplyCandidateButton_Click" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <Border Width="336"
                                    Padding="16,16,16,14"
                                    CornerRadius="8"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <Grid RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <TextBlock Text="方案 C"
                                                   FontSize="20"
                                                   FontWeight="SemiBold" />
                                        <Button x:Name="Option3KeepButton"
                                                Width="30"
                                                Height="30"
                                                Padding="0"
                                                Margin="0,-4,-4,0"
                                                Tag="2"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Click="ToggleKeepButton_Click" />
                                    </Grid>
                                    <TextBlock x:Name="Option3SummaryText"
                                               Grid.Row="1"
                                               MinHeight="126"
                                               Text="等待生成"
                                               TextWrapping="Wrap" />
                                    <Grid Grid.Row="2"
                                          ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="Option3PlayButton"
                                                Grid.Column="0"
                                                Tag="2"
                                                Height="36"
                                                MinWidth="92"
                                                Padding="14,8"
                                                Click="PlayCandidateButton_Click" />
                                        <Button x:Name="Option3ApplyButton"
                                                Grid.Column="1"
                                                Tag="2"
                                                Height="36"
                                                Content="写入编辑页"
                                                IsEnabled="False"
                                                Click="ApplyCandidateButton_Click" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
