<Page
    x:Class="MusicBox.ComposeWorkbenchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{x:Null}">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      VerticalScrollMode="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Disabled">
            <Grid Padding="32,24,32,24">
                <StackPanel Spacing="14">
                    <TextBlock Text="智能创作"
                               FontSize="24"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="自动决定速度、拍号和调号，一次生成 3 个候选方案。每个卡片都可以直接试听。"
                               TextWrapping="Wrap"
                               Opacity="0.72"/>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="240"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="8">
                            <TextBlock Text="标题"/>
                            <TextBox x:Name="TitleBox" Text="智能创作"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="8">
                            <TextBlock Text="风格"/>
                            <ComboBox x:Name="StyleBox">
                                <ComboBoxItem Content="流行 Pop" Tag="pop"/>
                                <ComboBoxItem Content="民谣 Folk" Tag="folk"/>
                                <ComboBoxItem Content="氛围 Ambient" Tag="ambient"/>
                                <ComboBoxItem Content="舞曲 Dance" Tag="dance"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="8">
                            <TextBlock Text="情绪"/>
                            <ComboBox x:Name="MoodBox">
                                <ComboBoxItem Content="平静 Calm" Tag="calm"/>
                                <ComboBoxItem Content="积极 Positive" Tag="positive"/>
                                <ComboBoxItem Content="伤感 Sad" Tag="sad"/>
                                <ComboBoxItem Content="助眠 Sleep" Tag="sleep"/>
                                <ComboBoxItem Content="希望 Hopeful" Tag="hopeful"/>
                                <ComboBoxItem Content="怀旧 Nostalgic" Tag="nostalgic"/>
                                <ComboBoxItem Content="梦幻 Dreamy" Tag="dreamy"/>
                                <ComboBoxItem Content="紧张 Tense" Tag="tense"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="3" Spacing="8">
                            <TextBlock Text="长度"/>
                            <ComboBox x:Name="LengthBox">
                                <ComboBoxItem Content="短（约 16 小节）" Tag="short"/>
                                <ComboBoxItem Content="中（约 32 小节）" Tag="medium"/>
                                <ComboBoxItem Content="长（约 64 小节）" Tag="long"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="GenerateButton"
                                Content="生成 3 组"
                                Click="GenerateButton_Click"/>
                        <Button x:Name="RetryButton"
                                Content="再来 3 组"
                                Click="RetryButton_Click"/>
                        <TextBlock x:Name="StatusText"
                                   VerticalAlignment="Center"
                                   Opacity="0.72"
                                   Text="还没有候选方案。"/>
                    </StackPanel>

                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  HorizontalScrollMode="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  VerticalScrollMode="Disabled">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Width="340"
                                    Padding="16"
                                    CornerRadius="8"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="方案 A" FontSize="20" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="Option1SummaryText" Text="等待生成" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="Option1PlayButton" Tag="0" Content="播放" Click="PlayCandidateButton_Click"/>
                                        <Button x:Name="Option1ApplyButton" Tag="0" Content="写入编辑页" IsEnabled="False" Click="ApplyCandidateButton_Click"/>
                                        <Button x:Name="Option1SendButton" Tag="0" Content="发送到转换页" IsEnabled="False" Click="SendCandidateButton_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Width="340"
                                    Padding="16"
                                    CornerRadius="8"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="方案 B" FontSize="20" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="Option2SummaryText" Text="等待生成" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="Option2PlayButton" Tag="1" Content="播放" Click="PlayCandidateButton_Click"/>
                                        <Button x:Name="Option2ApplyButton" Tag="1" Content="写入编辑页" IsEnabled="False" Click="ApplyCandidateButton_Click"/>
                                        <Button x:Name="Option2SendButton" Tag="1" Content="发送到转换页" IsEnabled="False" Click="SendCandidateButton_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Width="340"
                                    Padding="16"
                                    CornerRadius="8"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="方案 C" FontSize="20" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="Option3SummaryText" Text="等待生成" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="Option3PlayButton" Tag="2" Content="播放" Click="PlayCandidateButton_Click"/>
                                        <Button x:Name="Option3ApplyButton" Tag="2" Content="写入编辑页" IsEnabled="False" Click="ApplyCandidateButton_Click"/>
                                        <Button x:Name="Option3SendButton" Tag="2" Content="发送到转换页" IsEnabled="False" Click="SendCandidateButton_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
