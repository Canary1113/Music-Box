<Page
    x:Class="音乐魔盒.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{x:Null}">

    <Page.Resources>
        <Style x:Key="SettingHeaderGridStyle" TargetType="Grid">
            <Setter Property="ColumnSpacing" Value="12"/>
        </Style>

        <Style x:Key="SettingCardBorderStyle" TargetType="Border">
            <Setter Property="Padding" Value="16,10,16,10"/>
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="SettingDescStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Style>
    </Page.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      VerticalScrollMode="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Disabled">
            <Grid Padding="48,24,48,24">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="PageTitleText"
                               Text="设置"
                               FontSize="24"
                               FontWeight="SemiBold"/>

                    <TextBlock x:Name="PersonalizationTitleText"
                               Text="个性化"
                               Style="{ThemeResource SubtitleTextBlockStyle}"
                               FontSize="14"/>

                    <Expander x:Name="ThemeExpander"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Left"
                              IsExpanded="True"
                              ExpandDirection="Down"
                              Background="Transparent"
                              BorderThickness="0"
                              CornerRadius="5"
                              Padding="0"
                              ContentTransitions="{x:Null}">
                        <Expander.Header>
                            <Grid Style="{StaticResource SettingHeaderGridStyle}"
                                  Margin="0,10,0,10"
                                  HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <FontIcon FontFamily="Segoe MDL2 Assets"
                                          Glyph="&#xE790;"
                                          VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock x:Name="ThemeTitleText" Text="主题"/>
                                    <TextBlock x:Name="ThemeDescText" Text="选择应用的外观主题" Style="{StaticResource SettingDescStyle}"/>
                                </StackPanel>

                                <TextBlock x:Name="ThemeSummaryText"
                                           Grid.Column="2"
                                           Text="使用系统设置"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Grid>
                        </Expander.Header>

                        <Expander.Content>
                            <StackPanel Spacing="8" Margin="48,10,0,10" HorizontalAlignment="Stretch">
                                <RadioButton x:Name="ThemeSystemRadio"
                                             GroupName="ThemeGroup"
                                             Content="使用系统设置"
                                             HorizontalAlignment="Left"
                                             Checked="ThemeRadio_Checked"/>

                                <RadioButton x:Name="ThemeLightRadio"
                                             GroupName="ThemeGroup"
                                             Content="浅色"
                                             HorizontalAlignment="Left"
                                             Checked="ThemeRadio_Checked"/>

                                <RadioButton x:Name="ThemeDarkRadio"
                                             GroupName="ThemeGroup"
                                             Content="深色"
                                             HorizontalAlignment="Left"
                                             Checked="ThemeRadio_Checked"/>
                            </StackPanel>
                        </Expander.Content>
                    </Expander>

                    <Border Style="{StaticResource SettingCardBorderStyle}" CornerRadius="5">
                        <Grid Style="{StaticResource SettingHeaderGridStyle}" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <FontIcon FontFamily="Segoe MDL2 Assets"
                                      Glyph="&#xE774;"
                                      VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Name="LanguageTitleText" Text="语言"/>
                                <TextBlock x:Name="LanguageDescText" Text="切换界面显示语言" Style="{StaticResource SettingDescStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" Spacing="4">
                                <ComboBox x:Name="LanguageComboBox"
                                          MinWidth="140"
                                          HorizontalAlignment="Right"
                                          SelectionChanged="LanguageComboBox_SelectionChanged">
                                    <ComboBoxItem Tag="system" Content="跟随系统"/>
                                    <ComboBoxItem Tag="zh-Hans" Content="简体中文"/>
                                    <ComboBoxItem Tag="en-US" Content="English"/>
                                </ComboBox>
                                <TextBlock x:Name="LanguageStatusText"
                                           Visibility="Collapsed"
                                           Style="{StaticResource SettingDescStyle}"
                                           Text=""/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="AboutSectionTitleText"
                               Text="软件信息"
                               Style="{ThemeResource SubtitleTextBlockStyle}"
                               FontSize="14"
                               Margin="0,10,0,0"/>

                    <Expander x:Name="AboutExpander"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Left"
                              IsExpanded="True"
                              ExpandDirection="Down"
                              Background="Transparent"
                              BorderThickness="0"
                              CornerRadius="5"
                              Padding="0"
                              ContentTransitions="{x:Null}">
                        <Expander.Header>
                            <Grid Style="{StaticResource SettingHeaderGridStyle}"
                                  Margin="0,15,0,15"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <FontIcon FontFamily="Segoe MDL2 Assets"
                                          Glyph="&#xE946;"
                                          VerticalAlignment="Center"/>

                                <TextBlock x:Name="AboutTitleText"
                                           Grid.Column="1"
                                           Text="软件信息"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Expander.Header>

                        <Expander.Content>
                            <Grid Margin="48,10,0,10" RowSpacing="10" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock x:Name="AboutNameLabelText"
                                           Grid.Row="0"
                                           Grid.Column="0"
                                           Text="软件名"
                                           FontSize="13"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock x:Name="AboutNameValueText"
                                           Grid.Row="0"
                                           Grid.Column="1"
                                           Text="音乐魔盒"
                                           FontSize="13"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                <TextBlock x:Name="AboutVersionLabelText"
                                           Grid.Row="1"
                                           Grid.Column="0"
                                           Text="版本号"
                                           FontSize="13"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock x:Name="AboutVersionValueText"
                                           Grid.Row="1"
                                           Grid.Column="1"
                                           Text="--"
                                           FontSize="13"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                <TextBlock x:Name="AboutBuildLabelText"
                                           Grid.Row="2"
                                           Grid.Column="0"
                                           Text="构建时间"
                                           FontSize="13"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock x:Name="AboutBuildValueText"
                                           Grid.Row="2"
                                           Grid.Column="1"
                                           Text="--"
                                           FontSize="13"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                <TextBlock x:Name="AboutAuthorLabelText"
                                           Grid.Row="3"
                                           Grid.Column="0"
                                           Text="作者"
                                           FontSize="13"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock x:Name="AboutAuthorValueText"
                                           Grid.Row="3"
                                           Grid.Column="1"
                                           Text="蜇人鱼"
                                           FontSize="13"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                <TextBlock x:Name="AboutEmailLabelText"
                                           Grid.Row="4"
                                           Grid.Column="0"
                                           Text="邮箱"
                                           FontSize="13"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                <TextBlock x:Name="AboutEmailValueText"
                                           Grid.Row="4"
                                           Grid.Column="1"
                                           Text="y-zheren1@outlook.com"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Grid>
                        </Expander.Content>
                    </Expander>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>

